@model List<FicArchive.Web.Models.Work>
@{
    ViewData["Title"] = "Browse Stories";
}

<h1>All Stories</h1>

<div class="row">
    @foreach (var work in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">
                        <a asp-action="Details" asp-route-id="@work.Id">@work.Title</a>
                    </h5>
                    <p class="card-text"><small class="text-muted">@work.Rating | @work.Fandoms</small></p>
                    <p class="card-text">by @work.AuthorName</p>
                    <p class="card-text">@work.Summary</p>
                </div>
            </div>
        </div>
    }
</div>