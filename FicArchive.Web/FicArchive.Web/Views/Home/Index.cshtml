@model List<Work>

@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to FicArchive</h1>
    <p class="lead">A platform for reading and publishing stories</p>
</div>

<h2 class="mt-4">Latest Stories</h2>

@if (Model.Count == 0)
{
    <p>No stories yet.</p>
}
else
{
    <div class="row">
        @foreach (var work in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a asp-controller="Works" asp-action="Details" asp-route-id="@work.Id" class="text-decoration-none">
                                @work.Title
                            </a>
                        </h5>
                        <h6 class="card-subtitle mb-2 text-muted">by @work.AuthorName</h6>
                        <p class="card-text">@work.Summary</p>
                        <p class="card-text"><small class="text-muted">Published: @work.CreatedAt.ToString("MM/dd/yyyy")</small></p>
                    </div>
                </div>
            </div>
        }
    </div>
}